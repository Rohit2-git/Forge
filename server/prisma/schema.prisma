datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider  = "prisma-client-py"
  interface = "asyncio"
}

model TestRun {
  id            Int            @id @default(autoincrement())
  filename      String
  // Human-chosen label for this generation batch (e.g. "Checkout Flow").
  // Display everywhere falls back to filename when this is null/empty.
  batchName     String?
  total         Int
  status        String         @default("completed")
  appId         String?
  createdAt     DateTime       @default(now())

  // Visibility stamped at save time based on the generating user's role.
  // "all"            → admin-generated: visible to everyone with app access
  // "qa_and_reviewer"→ qa_engineer-generated: visible to qa_engineer (owner) + qa_reviewer
  // "owner_only"     → developer-generated: visible only to the developer who created it
  createdByUserId Int?
  createdByRole   String?       // "admin" | "qa_engineer" | "developer"
  visibility      String        @default("all")

  results       TestResult[]
  executionRuns ExecutionRun[]
}

model TestResult {
  id             Int      @id @default(autoincrement())
  runId          Int
  run            TestRun  @relation(fields: [runId], references: [id])
  title          String
  steps          String
  expectedResult String
  type           String
  // Which of the 5 generation categories this test case belongs to:
  // functional / regression / data_driven / smoke_e2e / ui. Defaults to
  // "functional" for rows saved before the category-split feature existed
  // and for anything (e.g. CSV import, manual entry) that doesn't set one.
  category       String   @default("functional")
  // The feature/page this test case targets (e.g. "Login", "Checkout") —
  // same feature_area tagging used across all 5 categories so a batch can
  // be browsed either by category or by feature. Nullable since older rows
  // predate this column and manual/CSV-imported cases may not have one.
  featureArea    String?
  createdAt      DateTime @default(now())

  testDataSourceType String?
  testDataSourceId   String?
  testDataValues     String?
}

model TestDataTemplate {
  id        String   @id @default(cuid())
  appId     String
  name      String
  scenario  String
  fields    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TestDataCondition {
  id             String   @id @default(cuid())
  appId          String
  description    String
  resolvedFields String
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model SyntheticBatch {
  id                 String   @id @default(cuid())
  appId              String
  sourceTemplateId   String
  sourceTemplateName String
  name               String
  recordCount        Int
  records            String
  createdAt          DateTime @default(now())
}

model ExecutionRun {
  id               Int               @id @default(autoincrement())
  runId            Int
  run              TestRun           @relation(fields: [runId], references: [id])
  baseUrl          String
  total            Int
  executed         Int
  passed           Int
  failed           Int
  notRun           Int
  stoppedEarly     Boolean           @default(false)
  // Wall-clock time the run took, start to finish, in milliseconds.
  // Nullable because runs from before this column existed have no value —
  // the Analytics "Execution Duration" chart treats null the same as 0
  // (no data), not an error. Populated in execute.py's /execute/single,
  // /execute/suite, and /execute/nl handlers.
  durationMs       Int?
  createdAt        DateTime          @default(now())
  executionResults ExecutionResult[]
}

model ExecutionResult {
  id             Int          @id @default(autoincrement())
  executionRunId Int
  executionRun   ExecutionRun @relation(fields: [executionRunId], references: [id])
  title          String
  passed         Boolean
  type           String
  expectedResult String
  agentOutput    String
  stepResults    String
  screenshotPaths String?
  videoPath       String?
  createdAt      DateTime     @default(now())
}

// Cached result of a Playwright discovery crawl of an Application's live URL.
// One row per app — re-scouting overwrites the same row rather than piling up
// history, since only the current workflow inventory matters for the Coverage
// Index. pageLimit is user-configurable (Coverage tab settings) and controls
// how many same-origin pages the next scout/rescan crawls.
model AppScoutProfile {
  id                 String    @id @default(cuid())
  appId              String    @unique
  status             String    @default("pending") // pending | scanning | ready | failed
  errorMessage       String?
  pageLimit          Int       @default(15)
  pagesScanned       Int       @default(0)
  totalElements      Int       @default(0)
  // JSON-encoded list of clustered workflow objects — see scout_application()
  // in playwright.py for shape: [{ intent, routePattern, label, instanceCount,
  // variants, examplePageUrl }, ...]
  workflows          String    @default("[]")
  estimatedTestCases Int       @default(0)
  scoutDurationSec   Float?
  authAttempted      Boolean   @default(false)
  authSucceeded      Boolean   @default(false)
  scoutedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// One row per full-site crawl run kicked off from the Crawler Agent tab.
// Unlike AppScoutProfile (Coverage Index — page-limited, clustered into
// workflows, overwritten on every re-scan), a CrawlSession is unbounded
// (crawls every same-origin page it can reach, up to a hard safety cap —
// see CRAWL_HARD_PAGE_CAP / CRAWL_HARD_DURATION_SEC in crawler.py) and is
// KEPT as history — each run gets its own row plus its own CrawlPage rows,
// so past crawls stay browsable instead of being overwritten by the next one.
model CrawlSession {
  id            String      @id @default(cuid())
  appId         String
  baseUrl       String
  status        String      @default("running") // running | completed | failed | stopped
  errorMessage  String?
  pagesCrawled  Int         @default(0)
  totalElements Int         @default(0)
  authAttempted Boolean     @default(false)
  authSucceeded Boolean     @default(false)
  durationSec   Float?
  createdAt     DateTime    @default(now())
  finishedAt    DateTime?
  pages         CrawlPage[]
}

// One row per page visited during a CrawlSession. `elements` is a JSON-encoded
// array of every interactive element found on that page (tag, id, name,
// className, role, label, selector, etc. — see crawler.py's
// _extract_page_elements_detailed for the exact shape) and is intentionally
// plain text (not further normalized into its own table) so it stays trivial
// to hand-edit from the Crawler Agent UI and to export as one JSON blob.
model CrawlPage {
  id             String       @id @default(cuid())
  sessionId      String
  session        CrawlSession @relation(fields: [sessionId], references: [id])
  url            String
  title          String?
  status         String       @default("ok") // ok | failed
  errorMessage   String?
  screenshotPath String?
  elements       String       @default("[]")
  elementCount   Int          @default(0)
  crawledAt      DateTime     @default(now())
  editedAt       DateTime?

  @@index([sessionId])
}

model KnowledgeAsset {
  id        Int      @id @default(autoincrement())
  appId     String
  name      String
  type      String
  summary   String
  tags      String
  url       String?
  createdAt DateTime @default(now())
}

model User {
  id             Int              @id @default(autoincrement())
  email          String           @unique
  passwordHash   String
  name           String
  role           String           @default("qa_reviewer")
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  roleRequests   RoleRequest[]
  appAccess      UserAppAccess[]
}

model Application {
  id          String         @id
  name        String
  description String         @default("")
  platform    String         @default("web")
  url         String         @default("http://localhost")
  status      String         @default("active")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  appAccess   UserAppAccess[]
}

model UserAppAccess {
  id        Int         @id @default(autoincrement())
  userId    Int
  user      User        @relation(fields: [userId], references: [id])
  appId     String
  app       Application @relation(fields: [appId], references: [id])
  createdAt DateTime    @default(now())

  @@unique([userId, appId])
}

model RoleRequest {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id])
  requestedRole String
  reason        String
  status        String   @default("pending")
  reviewedBy    Int?
  reviewNote    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
